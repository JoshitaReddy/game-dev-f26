# Documentation only: Python does not load this file automatically.
# Select a live provider with --provider vertex, anthropic or openai.
# COURSE_MODEL is an explicit model ID supported by the selected adapter.
# Never put credentials in this tracked file.
COURSE_MODEL=replace-with-your-chosen-model-id
# Vertex only: get course-funded access settings from the instructor.
GOOGLE_CLOUD_PROJECT=replace-with-course-project
GOOGLE_CLOUD_LOCATION=replace-with-approved-location
# Anthropic only: set ANTHROPIC_API_KEY securely in your local environment.
# OpenAI only: set OPENAI_API_KEY securely in your local environment.
